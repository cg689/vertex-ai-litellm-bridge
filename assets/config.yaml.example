# LiteLLM 配置模板 —— 把 Vertex AI (Gemini) 暴露成 OpenAI 兼容端点
#
# 用法：
#   1. 把 <PROJECT_ID> / <USER> / <project> 替换成实际值
#   2. 放到 C:\Users\<USER>\.zcode\litellm\config.yaml
#   3. 启动：litellm.exe --config config.yaml --host 127.0.0.1 --port 4000 --num_workers 1
#
# 关键点：
#   - model 必须带 vertex_ai/ 前缀，否则 LiteLLM 会走 Google AI Studio（那套不消耗赠金）
#   - vertex_credentials 要绝对路径，指向服务账号 JSON
#   - vertex_location 统一用 global（preview 模型只在这里有）
#   - drop_params: true，客户端可能发 Vertex 不认的参数

model_list:
  - model_name: gemini-3.8-flash
    litellm_params:
      model: vertex_ai/gemini-3.8-flash
      vertex_project: <PROJECT_ID>
      vertex_location: global
      vertex_credentials: C:\Users\<USER>\.zcode\secrets\<project>.json

  - model_name: gemini-3.7-flash
    litellm_params:
      model: vertex_ai/gemini-3.7-flash
      vertex_project: <PROJECT_ID>
      vertex_location: global
      vertex_credentials: C:\Users\<USER>\.zcode\secrets\<project>.json

  - model_name: gemini-2.5-flash
    litellm_params:
      model: vertex_ai/gemini-2.5-flash
      vertex_project: <PROJECT_ID>
      vertex_location: global
      vertex_credentials: C:\Users\<USER>\.zcode\secrets\<project>.json

  - model_name: gemini-2.5-pro
    litellm_params:
      model: vertex_ai/gemini-2.5-pro
      vertex_project: <PROJECT_ID>
      vertex_location: global
      vertex_credentials: C:\Users\<USER>\.zcode\secrets\<project>.json

  - model_name: gemini-3.1-pro-preview
    litellm_params:
      model: vertex_ai/gemini-3.1-pro-preview
      vertex_project: <PROJECT_ID>
      vertex_location: global
      vertex_credentials: C:\Users\<USER>\.zcode\secrets\<project>.json

general_settings:
  # 客户端就填这个作为 API Key
  # 自己生成一串随机字符，别用弱口令；改完记得同步改客户端里的 apiKey
  # 注意：不要把这个值写进任何会被分享/同步的文件（skill、README、Git）
  master_key: <MASTER_KEY>

litellm_settings:
  # 客户端可能发送 Vertex 不支持的参数，让 LiteLLM 静默丢弃
  drop_params: true
  # 想用 virtual key（可限模型/预算/速率）才需要接数据库；
  # 单机个人场景不接也能跑，但只能用 master key，且 key 填错时会报
  # "400 No connected db."（看着像数据库问题，实际是 key 不对）
  # database_url: postgresql://litellm:pwd@localhost:5432/litellm

router_settings:
  # 上游偶发 429/503 时自动重试，不要直接透传给客户端
  num_retries: 2
  retry_after: 3
  # 长上下文 + thinking 模型首字延迟可能超 30 秒，别用默认值
  timeout: 120
